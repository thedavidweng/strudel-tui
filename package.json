{
  "name": "strudel-tui",
  "version": "0.1.0",
  "description": "Terminal based live coding interface for Strudel.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "strudel-tui": "bin/strudel-tui"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile bin/strudel-tui"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.80.3",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "chalk": "^6.0.0",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "knip": "^6.26.0",
    "oxlint": "^1.68.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "patchedDependencies": {
    "@kabelsalat/web@0.4.1": "patches/@kabelsalat%2Fweb@0.4.1.patch"
  }
}