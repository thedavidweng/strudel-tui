{
  "name": "strudel-tui",
  "version": "0.1.0",
  "description": "Terminal based live coding interface for Strudel.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "strudel-tui": "bin/strudel-tui"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --compile --outfile bin/strudel-tui",
    "postinstall": "node scripts/patch-kabelsalat.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.1",
    "@kabelsalat/web": "^0.4.1",
    "@strudel/core": "latest",
    "@strudel/mini": "latest",
    "@strudel/transpiler": "latest",
    "chalk": "^5.4.0",
    "citty": "latest",
    "cli-highlight": "^2.1.11"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}